{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/guide",
      "destination": "/guide/index.html"
    },
    {
      "source": "/beaches",
      "destination": "/beaches/index.html"
    },
    {
      "source": "/beaches/:slug",
      "destination": "/beaches/:slug/index.html"
    },
    {
      "source": "/bio-bay",
      "destination": "/bio-bay/index.html"
    },
    {
      "source": "/ferry",
      "destination": "/ferry/index.html"
    },
    {
      "source": "/getting-around",
      "destination": "/getting-around/index.html"
    },
    {
      "source": "/restaurants",
      "destination": "/restaurants/index.html"
    },
    {
      "source": "/:page(signup|login|pricing|success|welcome|forgot-password|reset-password|terms|privacy|refunds|account)",
      "destination": "/index.html"
    }
  ]
}
