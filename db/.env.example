# Vieques AI — database environment
# Copy this file to  db/.env  and fill in the real pooler password.
# db/.env is gitignored; never commit real credentials.
#
# These scripts (db/scripts/*.sh) connect to the Supabase Postgres
# pooler, not a local Postgres install. Get DB_PASSWORD and the
# project ref from: Supabase dashboard → Project Settings → Database
# → Connection pooling (reset the password there if you don't have it).

DB_NAME=postgres
DB_USER=postgres.<your-project-ref>
DB_PASSWORD=change_me
DB_HOST=aws-0-us-east-1.pooler.supabase.com
DB_PORT=5432

# Full connection string (handy for app code / psql):
# DATABASE_URL=postgresql://postgres.<your-project-ref>:change_me@aws-0-us-east-1.pooler.supabase.com:5432/postgres
