# ============================================================
# Explore Vieques — backend environment
# Copy to .env for local dev. On Railway/Render, set these as
# service variables instead (never commit real secrets).
# This file doubles as the checklist of vars the deploy needs.
# ============================================================

# --- Server ---
# PORT is injected automatically by Railway/Render — leave it unset there.
# Locally the server falls back to 3001.
PORT=3001
# MUST be "production" on the deploy host. It turns OFF the dev-only
# "allow any localhost origin" CORS rule in server.js.
NODE_ENV=development

# --- Database ---
# Supabase pooler connection string. Supabase dashboard ->
# Project Settings -> Database -> Connection string -> "Transaction pooler"
# (port 6543). If DATABASE_URL is set it wins over the DB_* fallback below.
# The ?search_path is handled in code (pool options), no need to add it here.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# LOCAL-ONLY fallback, used only when DATABASE_URL is unset:
DB_NAME=vieques_ai
DB_USER=vieques_app
DB_PASSWORD=changeme
DB_HOST=localhost
DB_PORT=5432

# --- Supabase (used to verify the user's JWT on protected routes) ---
SUPABASE_URL=https://<ref>.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# --- Stripe (secret key stays server-side; never in the browser) ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...           # from the Stripe webhook you register

# --- Ask AI provider (the CHEAP model — powers /api/ai/chat for every tier) ---
# The chat pane answers shallow lookup questions over ~100 island records, so it
# runs on a cheap model rather than Claude (~10x the cost per token).
#
# AI_PROVIDER selects the endpoint; all of these speak the OpenAI wire format,
# so switching is an env change with no code change:
#   gemini  (default) — https://generativelanguage.googleapis.com/v1beta/openai/
#   ollama            — self-hosted; set AI_BASE_URL to your box's /v1
#   openai            — uses OPENAI_API_KEY instead of GEMINI_API_KEY
AI_PROVIDER=gemini
AI_MODEL=gemini-3.1-flash-lite

# Get a key at https://aistudio.google.com/apikey (free tier available).
# Gemini 3.1 Flash-Lite is $0.25 / $1.50 per million input/output tokens on the
# paid tier, and free below the free-tier limits.
#
# NOTE: gemini-2.5-flash-lite is closed to new API keys (404 "no longer
# available to new users") — do not switch AI_MODEL to it. 3.1-flash-lite is
# also cheaper than 3.5-flash-lite ($0.30/$2.50).
GEMINI_API_KEY=

# Only for ollama or another self-hosted OpenAI-compatible server, e.g.
#   AI_BASE_URL=http://192.168.1.50:11434/v1
# NOTE: Ollama is not viable on Railway (no GPU — a 7B model would take 60s+
# per turn on CPU). Host it on a machine with a GPU and point this at it.
AI_BASE_URL=

# --- Anthropic (Claude) — ITINERARY BUILDER ONLY, Exploration tier ---
# NOT used by Ask AI. Reserved for the itinerary builder, which is gated behind
# the 'itinerary' feature slug that only the Exploration plan holds.
ANTHROPIC_API_KEY=sk-ant-...

# --- Tripadvisor Content API (lodging ratings/reviews/photos) ---
# Powers GET /api/stays/:id/tripadvisor. Server-side only — never expose this
# to the browser (no VITE_ prefix, not in frontend/.env).
#
# IMPORTANT: every Content API key is restricted, and an unallowlisted caller
# gets a 403 whose message is identical for a valid and an invalid key:
#   "User is not authorized to access this resource with an explicit deny..."
# So a 403 tells you nothing about the key — check the allowlist first.
#
# In the Tripadvisor Content API portal each key takes EITHER an IP allowlist
# OR an HTTP-referer allowlist. Prefer the referer form for the deployed
# backend: Railway does not guarantee a stable egress IP, so an IP allowlist
# that works locally can still fail in production. Set TRIPADVISOR_REFERER to
# the allowlisted URL and the server sends it as a Referer header on every
# call. Leave it unset when the key is IP-restricted.
#
# When TRIPADVISOR_API_KEY is unset the stays list still works — the detail
# panel simply renders without the Tripadvisor block.
TRIPADVISOR_API_KEY=
TRIPADVISOR_REFERER=                      # e.g. https://app.explorevieques.org

# --- Frontend origins (used for CORS allowlist + Stripe redirect URLs) ---
LANDING_URL=http://localhost:5174         # https://explorevieques.org in prod
APP_URL=http://localhost:5173             # https://app.explorevieques.org in prod
