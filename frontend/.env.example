# --- Map app (frontend/) environment ---
# Copy to .env for local dev; set the same keys in the Vercel project settings
# for production (Project → Settings → Environment Variables).

# MapTiler style/tiles API key (client-side).
VITE_MAPTILER_KEY=

# Supabase project the map app authenticates against.
VITE_SUPABASE_URL=https://<ref>.supabase.co
VITE_SUPABASE_ANON_KEY=

# Backend API base URL.
#   local:  http://localhost:3001
#   prod:   https://<your-railway-app>.up.railway.app  (or api.explorevieques.org)
VITE_API_BASE=http://localhost:3001

# Landing site origin — AccessGate bounces unauthenticated users here.
#   local:  http://localhost:5174
#   prod:   https://explorevieques.org
VITE_LANDING_URL=http://localhost:5174
